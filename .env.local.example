# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# SUPER ADMIN DASHBOARD (/ashwini-control) — owner-only.
# ============================================================
#
# The immutable auth UUID of the ONE account allowed into the admin
# area. No code path can create an owner: provision by copying the
# UUID of an existing account you already trust (Supabase →
# Authentication → Users → the row's UUID, or
# `select id from auth.users where email = 'you@example.com'`).
#
# Server-only. Never expose it to the browser. Fail closed: if this
# is unset, /ashwini-control denies everyone (the client app is
# unaffected) and the server logs a warning naming this variable.
#ADMIN_OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
#
# Several Ashwini accounts connecting several WABAs under ONE Meta App
# need only that app's secret — this is the normal multi-WABA setup.
# If your WABAs live under DIFFERENT Meta Apps (each app signs with
# its own secret), list every app's secret separated by commas; a
# webhook is accepted when its signature matches any of them.
# Whitespace around the commas is ignored. See docs/multi-waba.md.
#   META_APP_SECRET=secret-of-app-one,secret-of-app-two
META_APP_SECRET=your-meta-app-secret

# Webhook verify token — the string you also type into
# Meta → App Dashboard → WhatsApp → Configuration → Callback URL →
# Verify token. Normally each account stores its own token in
# whatsapp_config (typed on Settings → WhatsApp, encrypted at rest and
# never displayed again once saved). This env var is the self-hosting
# shortcut: set it here and the handshake succeeds without touching the
# settings form. Comma-separate several values if one deployment fronts
# multiple Meta Apps. Unset = feature off, per-account tokens only.
# It gates ONLY the one-time hub.challenge handshake; inbound payloads
# are authenticated by META_APP_SECRET above.
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate-any-long-random-string

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is *only* needed when the request-derived
# origin would be wrong — e.g. when generating links from a cron job
# or a background worker that has no incoming request.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# UI language. Available catalogues (messages/*.json): en | ko | pt | es
# (English, Korean, Brazilian Portuguese, Latin American Spanish).
# Unknown values fall back to en. Inlined at build time — rebuild after changing.
NEXT_PUBLIC_APP_LOCALE=en

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the built-in fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Broadcast scheduler firing.
# A single self-hosted server fires due scheduled broadcasts on its own: an
# in-process timer runs every ~30s. It is armed at boot via
# src/instrumentation.ts (prod / `next start`) AND from the schedule + cron
# route handlers (required for `next dev`, where the register() boot hook
# does not run), so no external pinger is needed. The guarded HTTP endpoint
# GET /api/whatsapp/broadcast/scheduled/cron (same AUTOMATION_CRON_SECRET)
# remains for multi-instance / serverless deployments. Running both is safe:
# each campaign is claimed with one conditional UPDATE, so it never
# double-sends.
#
# Set to true ONLY if you want an external pinger/cron to be the sole
# trigger and prefer the server not self-fire.
# BROADCAST_SCHEDULER_DISABLED=false

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
#
# Single value only — unlike META_APP_SECRET it does not take a list.
# With WABAs under several Meta Apps, image-header template uploads go
# through this one app for every account (docs/multi-waba.md, setup C).
# META_APP_ID=your-meta-app-id

# ------------------------------------------------------------------
# WhatsApp Embedded Signup (optional — "Connect with Meta" button)
# ------------------------------------------------------------------
# Meta's official one-click onboarding, offered alongside (not instead
# of) the manual credential form on Settings → WhatsApp. Both paths
# write the same whatsapp_config row.
#
# Requires a "WhatsApp Embedded Signup Configuration" created in the
# Meta App Dashboard (Facebook Login for Business → Configurations).
# Its id is the config_id passed to FB.login.
#
# The two NEXT_PUBLIC_ values run in the browser (FB.init appId and the
# FB.login config_id), so they must be public. The server reuses the
# existing META_APP_ID + META_APP_SECRET above to exchange the returned
# code for a business token (POST /api/whatsapp/embedded-signup/callback
# refuses if either is unset). Set all four to enable the button; leave
# them unset to hide it and keep manual-only setup.
# NEXT_PUBLIC_META_APP_ID=your-meta-app-id
# NEXT_PUBLIC_WHATSAPP_CONFIG_ID=your-embedded-signup-config-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI or Anthropic key under Settings → AI Assistant. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → AI Assistant. Still no env var required.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# ------------------------------------------------------------------
# Payment gateway — Razorpay subscriptions (optional — paid plans)
# ------------------------------------------------------------------
# Plans, prices, limits and yearly figures all live in the database
# (migrations 048 + 052: plans, plan_prices, plan_limits,
# plan_yearly_limits, plan_yearly_multipliers). The vars below only connect
# the gateway. With none of them set the app behaves exactly as it did
# before: the pricing cards still render from the database, and a paid
# checkout answers `gateway_not_configured` instead of half-starting.
#
# Test mode vs live mode is just a different key pair — nothing else changes.
# RAZORPAY_KEY_ID is handed to the browser (it is checkout.js's `key`); the
# secret is server-only and no route returns it.
#   RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
#   RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
#
# HMAC signature check on POST /api/billing/webhook (Razorpay Dashboard →
# Webhooks → secret). Required for activation: without it every webhook event
# is rejected, so a paid subscription would never turn active. A missing
# header is a rejection, never a bypass.
#   RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
#
# Override only behind a proxy or a mock gateway.
#   RAZORPAY_API_BASE=https://api.razorpay.com/v1
#
# After the keys exist, mint the gateway plans (monthly + yearly per paid
# plan) once and store their ids on plan_prices.gateway_plan_id:
#   POST /api/ashwini-control/gateway/sync-plans   (owner-only)
# It is idempotent — a row that already has an id is left alone.

# ------------------------------------------------------------------
# Yearly billing switch
# ------------------------------------------------------------------
# ON by default: unset, or any value other than "false", shows the
# Monthly/Yearly toggle wherever the plan DATA supports it. Availability per
# plan is data, not a flag — a plan missing a yearly price row or a yearly
# gateway plan id keeps its monthly offer and its yearly option reads
# "Yearly billing is not available for this plan yet", so a broken checkout
# can never be offered.
#
# Set to "false" to hide the toggle and force every reader (pricing cards,
# the enforcement engine, the billing tab, the admin vault) down the monthly
# path — byte-for-byte the pre-yearly behaviour, with no data touched.
# YEARLY_BILLING_ENABLED=false
#
# The yearly figures themselves are NOT env: they are the rows in
# plan_yearly_multipliers (price, contacts, bulk_messages, templates,
# quick_replies, automation_flows, whatsapp_forms, team_members), read once
# by the 052 seed, which stores the explicit yearly values. Changing a
# multiplier to 1 is an UPDATE on that table plus a re-run of the seed —
# never a code change.
