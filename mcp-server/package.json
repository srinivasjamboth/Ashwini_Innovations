{
  "name": "ashwini-mcp",
  "version": "0.1.1",
  "description": "Model Context Protocol (MCP) server for Ashwini — drive your self-hosted WhatsApp CRM from Claude, Cursor, and other MCP clients.",
  "license": "UNLICENSED",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ashwini",
    "whatsapp",
    "crm",
    "claude",
    "ai"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "ashwini-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.7.0"
  }
}
